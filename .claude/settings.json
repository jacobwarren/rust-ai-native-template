{
  "permissions": {
    "ask": [
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Edit(/harness/goldens/**)",
      "Edit(/harness/config.json)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent-hook.sh\" guard claude",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
