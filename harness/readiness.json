{
  "schema_version": 1,
  "requirements": [
    {
      "id": "driver",
      "implementation": [
        "crates/engine/src/protocol.rs",
        "crates/app/src/driver.rs"
      ],
      "tests": [
        "discovery_examples_are_real_commands_and_capture_replays",
        "strict_requests_and_nested_commands_fail_without_mutation"
      ],
      "workflows": [
        "script-parity",
        "rejected-edit"
      ]
    },
    {
      "id": "state",
      "implementation": [
        "crates/domain/src/board.rs",
        "crates/engine/src/lib.rs"
      ],
      "tests": [
        "generated_edits_match_reference_model_and_replay",
        "failed_replay_and_invalid_edit_preserve_all_observable_state"
      ],
      "workflows": [
        "replay-atomicity"
      ]
    },
    {
      "id": "persistence",
      "implementation": [
        "crates/engine/src/store.rs"
      ],
      "tests": [
        "store::tests::roundtrip_preserves_state_journal_and_undo",
        "store::tests::failures_before_replace_preserve_committed_bytes",
        "store::tests::abrupt_process_exit_reopens_last_commit_and_ignores_orphan",
        "store::tests::error_after_replace_reports_uncertainty_instead_of_false_rollback"
      ],
      "workflows": [
        "board-lifecycle"
      ]
    },
    {
      "id": "evidence",
      "implementation": [
        "xtask/src/golden.rs",
        "xtask/src/readiness.rs"
      ],
      "tests": [
        "golden::tests::missing_and_changed_baselines_fail_without_writing_source",
        "readiness_rejects_stale_incomplete_and_missing_workflow_evidence",
        "workflow_grader_rejects_wrong_state_and_missing_golden_from_successful_app"
      ],
      "workflows": [
        "board-lifecycle",
        "rejected-edit"
      ]
    },
    {
      "id": "completion",
      "implementation": [
        "xtask/src/completion.rs",
        "xtask/src/tracking.rs",
        "xtask/src/transitions.rs",
        "scripts/agent-complete.sh"
      ],
      "tests": [
        "completion_requires_acceptance_and_fresh_evidence_but_not_closing_unrelated_gaps",
        "partial_and_blocked_handoffs_are_honest_and_do_not_claim_completion",
        "gap_transitions_require_exact_rationale_and_verified_closure",
        "hook_allows_register_repair_handoff_without_allowing_pr_or_completion",
        "hook_rejects_unverified_completion_and_accepts_explicit_partial_handoff",
        "prompt_only_work_needs_no_ticket_or_new_gap",
        "stop_hook_returns_specific_questions_for_missing_review",
        "material_discovery_requires_durable_record_but_can_remain_open_after_task"
      ],
      "workflows": []
    },
    {
      "id": "task-artifacts",
      "implementation": [
        "xtask/src/task_artifact.rs",
        "xtask/src/task_view.rs",
        "xtask/src/task_view.html",
        "xtask/src/task_quiz.js"
      ],
      "tests": [
        "artifact_lifecycle_preserves_preflight_and_requires_current_html",
        "artifact_rejects_invalid_quiz_and_escapes_authored_content",
        "artifact_history_cannot_be_rewritten_even_without_task_edits",
        "legacy_records_cannot_bypass_mandatory_artifacts",
        "partial_preflight_is_reviewable_but_not_complete",
        "concurrent_fixtures_have_independent_directories",
        "artifact_invalid_input_and_lock_leave_record_unchanged",
        "artifact_symlinks_and_orphans_are_rejected"
      ],
      "workflows": []
    },
    {
      "id": "discovery-workbench",
      "implementation": [
        "xtask/src/discovery.rs",
        "xtask/src/discovery_feedback.rs",
        "xtask/src/discovery_view.rs",
        "xtask/src/discovery_state.js",
        "xtask/src/discovery_ui.js"
      ],
      "tests": [
        "five_discovery_artifacts_are_required_and_escape_authored_content",
        "feedback_import_rejects_stale_wrong_task_and_invalid_choices_atomically",
        "discovery_revisions_preserve_history_and_do_not_reuse_old_answers",
        "discovery_requires_structured_sections_but_allows_documented_settled_states"
      ],
      "workflows": []
    },
    {
      "id": "authored-html",
      "implementation": [
        "xtask/src/authored.rs",
        "xtask/src/authored_command.rs"
      ],
      "tests": [
        "authored_layouts_are_unconstrained_and_templates_cannot_overwrite_them",
        "authored_feedback_accepts_open_payloads_and_rejects_stale_envelopes",
        "authored_contract_rejects_missing_purposes_paths_and_history_edits",
        "authored_partial_requires_discovery_and_final_requires_lifecycle",
        "authored_registration_rejects_symlink_assets_without_writing_ledger"
      ],
      "workflows": []
    },
    {
      "id": "artifact-style",
      "implementation": [
        "xtask/src/artifact_style.rs",
        "xtask/src/artifact_foundation.css",
        "scripts/test-artifact-style.cjs"
      ],
      "tests": [
        "shared_style_is_required_and_bundled_for_nested_and_supporting_pages",
        "shared_style_upgrade_preserves_historical_css_and_custom_html",
        "shared_style_install_rejects_symlink_and_active_writer"
      ],
      "workflows": []
    }
  ],
  "scopes": {
    "template": [
      "driver",
      "state",
      "persistence",
      "evidence",
      "completion",
      "task-artifacts",
      "discovery-workbench",
      "authored-html",
      "artifact-style"
    ],
    "product": [
      "driver",
      "state",
      "persistence",
      "evidence",
      "completion",
      "task-artifacts",
      "discovery-workbench",
      "authored-html",
      "artifact-style"
    ]
  }
}
