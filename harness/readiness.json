      "implementation": [
        "xtask/src/artifacts.rs",
        "xtask/src/artifact_hook.rs",
        "scripts/agent-artifact-write.sh",
        "scripts/artifact-screenshots.cjs",
        "xtask/src/size.rs",
        "xtask/src/checks.rs",
