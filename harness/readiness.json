{
  "schema_version": 1,
  "requirements": [
    {
      "id": "driver",
      "implementation": [
        "crates/engine/src/protocol.rs",
        "crates/app/src/driver.rs"
      ],
      "tests": [
        "discovery_examples_are_real_commands_and_capture_replays",
        "strict_requests_and_nested_commands_fail_without_mutation"
      ],
      "workflows": [
        "script-parity",
        "rejected-edit"
      ]
    },
    {
      "id": "state",
      "implementation": [
        "crates/domain/src/board.rs",
        "crates/engine/src/lib.rs"
      ],
      "tests": [
        "generated_edits_match_reference_model_and_replay",
        "failed_replay_and_invalid_edit_preserve_all_observable_state"
      ],
      "workflows": [
        "replay-atomicity"
      ]
    },
    {
      "id": "persistence",
      "implementation": [
        "crates/engine/src/store.rs"
      ],
      "tests": [
        "store::tests::roundtrip_preserves_state_journal_and_undo",
        "store::tests::failures_before_replace_preserve_committed_bytes",
        "store::tests::abrupt_process_exit_reopens_last_commit_and_ignores_orphan",
        "store::tests::error_after_replace_reports_uncertainty_instead_of_false_rollback"
      ],
      "workflows": [
        "board-lifecycle"
      ]
    },
    {
      "id": "evidence",
      "implementation": [
        "xtask/src/golden.rs",
        "xtask/src/readiness.rs"
      ],
      "tests": [
        "golden::tests::missing_and_changed_baselines_fail_without_writing_source",
        "readiness_rejects_stale_incomplete_and_missing_workflow_evidence",
        "workflow_grader_rejects_wrong_state_and_missing_golden_from_successful_app"
      ],
      "workflows": [
        "board-lifecycle",
        "rejected-edit"
      ]
    },
    {
      "id": "completion",
      "implementation": [
        "xtask/src/completion.rs",
        "xtask/src/tracking.rs",
        "xtask/src/transitions.rs",
        "scripts/agent-complete.sh"
      ],
      "tests": [
        "completion_requires_acceptance_and_fresh_evidence_but_not_closing_unrelated_gaps",
        "partial_and_blocked_handoffs_are_honest_and_do_not_claim_completion",
        "gap_transitions_require_exact_rationale_and_verified_closure",
        "hook_allows_register_repair_handoff_without_allowing_pr_or_completion",
        "hook_rejects_unverified_completion_and_accepts_explicit_partial_handoff",
        "prompt_only_work_needs_no_ticket_or_new_gap",
        "stop_hook_returns_specific_questions_for_missing_review",
        "material_discovery_requires_durable_record_but_can_remain_open_after_task"
      ],
      "workflows": []
    },
    {
      "id": "task-artifacts",
      "implementation": [
        "xtask/src/artifacts.rs",
        "xtask/src/artifact_hook.rs",
        "scripts/agent-artifact-write.sh"
      ],
      "tests": [
        "completion_requires_eight_pages_linking_the_task_stylesheet",
        "discovery_must_be_committed_before_the_first_code_commit",
        "notes_must_land_during_the_work_and_final_pages_after_it",
        "completion_requires_committed_code_and_pages",
        "guard_blocks_code_edits_until_discovery_is_committed",
        "merged_target_commits_do_not_count_as_task_code",
        "concurrent_fixtures_have_independent_directories"
      ],
      "workflows": []
    }
  ],
  "scopes": {
    "template": [
      "driver",
      "state",
      "persistence",
      "evidence",
      "completion",
      "task-artifacts"
    ],
    "product": [
      "driver",
      "state",
      "persistence",
      "evidence",
      "completion",
      "task-artifacts"
    ]
  }
}
