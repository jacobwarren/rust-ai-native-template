        "guard_asks_claude_and_blocks_codex_on_golden_edits",
        "guard_reads_every_patch_path_and_blocks_what_it_cannot_read",
        "guard_notes_policy_files_and_passes_product_files",
        "guard_asks_before_the_dependency_allowlist_changes",
        "cargo_add_asks_through_rules_not_the_guard",
        "guard_catches_shell_writes_to_goldens_but_not_mentions",
        "guard_asks_before_merges_and_refuses_force_pushes",
        "guard_never_runs_cargo",
        "guard_fails_closed_on_an_internal_error",
        "transitions::tests::guard_tiers_match_protected_paths",
        "stop_allows_turns_that_claim_nothing",
        "stop_refuses_an_unverified_claim_and_allows_a_verified_one",
        "stop_blocks_a_claim_when_the_gate_cannot_run",
        "task_record::tests::stop_claim_pattern_matches_parsed_status",
        "host_local_files_do_not_change_the_tree",
        "committed_local_settings_are_still_reported",
        "hook_configs_wire_existing_scripts_and_no_subagent_stop",
        "guard_folds_case_where_git_ignores_case",
        "stop_judges_only_this_branchs_records_when_stacked"
      ],
      "workflows": []
    },
    {
