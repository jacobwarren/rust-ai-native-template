              "method": "capture"
            }
          }
        ],
        "exit_code": 2,
        "expect": [
          {
            "kind": "exact",
            "value": {
              "schema_version": 1,
              "id": 1,
              "ok": true,
              "result": {
                "id": 1
              }
            }
          },
          {
            "kind": "fields",
            "pointers": {
              "/ok": false,
              "/error/code": "invalid_task"
            }
          },
          {
            "kind": "fields",
            "pointers": {
              "/ok": false,
              "/error/code": "invalid_request"
            }
          },
          {
            "kind": "fields",
            "pointers": {
              "/ok": false,
              "/error/code": "invalid_request"
            }
          },
          {
            "kind": "fields",
            "pointers": {
              "/ok": false,
              "/error/code": "invalid_title"
            }
