  },
  {
    "id": "replay-atomicity",
    "boundary": "process",
    "criterion": "Replay fails atomically and valid journals reconstruct state including undo",
    "sessions": [
      {
        "transport": "stdin",
        "requests": [
          {
            "schema_version": 1,
            "id": 1,
            "action": {
              "method": "execute",
              "command": {
                "command": "add",
                "title": "Keep"
              }
            }
          },
          {
            "schema_version": 1,
            "id": 2,
            "action": {
              "method": "replay",
              "commands": [
                {
                  "command": "add",
                  "title": "Replace"
                },
                {
                  "command": "remove",
                  "id": 99
                }
              ]
            }
          },
          {
            "schema_version": 1,
            "id": 3,
            "action": {
              "method": "capture"
            }
          },
          {
            "schema_version": 1,
            "id": 4,
            "action": {
              "method": "replay",
              "commands": [
                {
                  "command": "add",
                  "title": "A"
                },
                {
                  "command": "remove",
                  "id": 1
                },
                {
                  "command": "undo"
                }
              ]
            }
          },
          {
            "schema_version": 1,
            "id": 5,
            "action": {
              "method": "capture"
            }
          }
        ],
        "exit_code": 2,
        "expect": [
          {
            "kind": "exact",
            "value": {
              "schema_version": 1,
              "id": 1,
              "ok": true,
              "result": {
                "id": 1
              }
            }
          },
          {
            "kind": "fields",
            "pointers": {
              "/ok": false,
              "/error/code": "replay_failed"
            }
          },
          {
            "kind": "golden",
            "path": "harness/goldens/kept.json",
            "pointer": "/result/snapshot"
          },
          {
            "kind": "exact",
            "value": {
              "schema_version": 1,
              "id": 4,
              "ok": true,
              "result": {
                "tasks": [
                  {
                    "id": 1,
                    "title": "A",
                    "done": false
                  }
                ],
                "next_id": 2,
                "revision": 3,
                "can_undo": true
              }
            }
          },
          {
            "kind": "golden",
            "path": "harness/goldens/replayed.json",
            "pointer": "/result/snapshot"
          }
        ]
      }
    ]
  },
